# Copy to supabase/functions/.env (git-ignored). Never commit real values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# The private key PEM on one line, with literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-team-calendar-id@group.calendar.google.com
# Shared with Vault `calendar_sync_secret`. Any long random string.
CALENDAR_SYNC_SECRET=
