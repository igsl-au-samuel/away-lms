# Copy to supabase/functions/.env (git-ignored). Never commit real values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# The private key PEM on one line, with literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-team-calendar-id@group.calendar.google.com
# Shared with Vault `calendar_sync_secret`. Any long random string.
CALENDAR_SYNC_SECRET=

# #174 — email notifications. Names only: nothing here is a value, and this lane sets none of
# them. Until BREVO_API_KEY and the sender exist the function answers 500 before it claims a row,
# so an unconfigured stack sends nothing and spends no attempts.
# Created in the Brevo dashboard under API Keys & MCP. Not the SMTP key Supabase Auth uses.
BREVO_API_KEY=
# The one verified sender address ADR 0006 set up.
BREVO_SENDER_EMAIL=
# Optional display name; falls back to "Away".
BREVO_SENDER_NAME=
# Base for the link in each message, e.g. the Workers URL. Omit it and the mail says
# "Sign in to Away to see it." with no link rather than guessing at a host.
SITE_URL=
# Shared with Vault `email_notify_secret`. Any long random string.
EMAIL_NOTIFY_SECRET=
